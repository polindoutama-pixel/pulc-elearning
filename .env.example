# Node.js does not read this file automatically.
# Optional local use: node --env-file=.env server/index.js
PORT=3001
DATA_DIR=./data
# Non-production defaults to demo. Never use the demo database for real employee data.
PULC_DEMO=true
# Production requires a separate DATA_DIR, NODE_ENV=production, PULC_DEMO=false,
# HTTPS, and ADMIN_PASSWORD supplied securely before first initialization.
ADMIN_NIK=ADMIN
ADMIN_PASSWORD=
